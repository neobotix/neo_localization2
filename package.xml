<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>neo_localization2</name>
    <version>1.0.3</version>
    <description>
	Platform localization node based on laser sensors and a grid map.
    </description>
    <author>Max Wittal</author>
    <maintainer email="ros@neobotix.de">Neobotix GmbH</maintainer>
    <maintainer email="padmanabhan@neobotix.de">Pradheep Padmanabhan</maintainer>
    <license>MIT</license>
    <url>https://github.com/neobotix/neo_localization2</url>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <build_depend>nav2_common</build_depend>

    <depend>nav2_util</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_lifecycle</depend>
    <depend>rclcpp_components</depend>
    <depend>tf2</depend>
    <depend>tf2_eigen</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_sensor_msgs</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>std_srvs</depend>
    <depend>angles</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>

</package>
